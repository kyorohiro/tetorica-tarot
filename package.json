{
  "name": "tetorica-tarot",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=./",
    "preview": "vite preview",
    "tauri": "tauri",
    "build-sw": "node scripts/build-sw.mjs",
    "build:web": "npm run build-sw && tsc && vite build --base=./",
    "build:gh": "npm run build-sw && tsc && vite build --base=/tetorica-tarot/demo/",
    "build:gh2": "npm run build-sw && tsc && vite build --base=/tetorica-tarot/demo2/"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.8.0",
    "pixi.js": "^8.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
